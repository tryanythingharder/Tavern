# 复制为 .env.local 后填写；.env.local 已被 gitignore，不会提交
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# 文本模型（也可以在后台「渠道」里配置多条渠道）
TAVERN_MODEL_BASE_URL=https://your-upstream.example/v1
TAVERN_MODEL_API_KEY=sk-...
TAVERN_MODEL_NAME=your-model

# 管理员邮箱（逗号分隔）；注册后请执行 node scripts/promote-admin.mjs <email>
TAVERN_ADMIN_EMAILS=you@example.com

# 生产 HTTPS 必开
# TAVERN_COOKIE_SECURE=1
# TAVERN_REQUIRE_ADMIN_2FA=1
# TAVERN_REQUIRE_EMAIL_VERIFY=1
# TAVERN_GLOBAL_DAILY_TOKEN_CAP=2000000

# 可选：生图 / 语音（OpenAI 兼容）
# TAVERN_IMAGE_BASE_URL=https://your-upstream.example/v1
# TAVERN_IMAGE_API_KEY=sk-...
# TAVERN_IMAGE_MODEL=gpt-image-1
# TAVERN_IMAGE_SIZE=1024x1024
# TAVERN_TTS_BASE_URL=https://your-upstream.example/v1
# TAVERN_TTS_API_KEY=sk-...
# TAVERN_TTS_MODEL=tts-1
# TAVERN_TTS_VOICE=alloy

# 可选：点数与支付
# TAVERN_POINTS_IMAGE=20
# TAVERN_POINTS_TTS=5
# TAVERN_PRICE_PER_POINT_CENTS=1
# TAVERN_PAYMENT_SECRET=...

# 可选：备用线路（后台「单线路配置」也能填）
# TAVERN_MODEL_FALLBACKS=[{"baseUrl":"https://backup.example/v1","apiKey":"sk-...","model":"..."}]

# 平台日时区（签到、每日免费额度、每日 token 上限、后台「今日」按它算；默认 UTC）
TAVERN_TIMEZONE=UTC

# 以下都可以不写在这里，直接在后台「站点与服务」填写（后台优先于环境变量，密钥只写不读）：
# 运营主体与法务信息、客服邮箱、Stripe、R2/S3 媒体存储、异地备份、错误告警 webhook、自动内容审核、PWA 推送联系地址。
# 对应环境变量：TAVERN_SUPPORT_EMAIL、TAVERN_STRIPE_SECRET_KEY、TAVERN_STRIPE_WEBHOOK_SECRET、TAVERN_STORAGE_DRIVER、
# TAVERN_S3_ENDPOINT/BUCKET/REGION/PREFIX/ACCESS_KEY/SECRET_KEY、TAVERN_ALERT_WEBHOOK、TAVERN_MODERATION_KEY/URL/MODEL/BLOCK、TAVERN_VAPID_SUBJECT
# 备份：服务器 cron 每天跑 `npm run backup`，例如 0 3 * * * cd /srv/yehua/app && npm run backup
